# i3 config file (v4)
#
# Please see http://i3wm.org/docs/userguide.html for a complete reference!

set $mod Mod4
set $mod2 Mod1
# Alt
#set $mod Mod1

exec_always --no-startup-id xset r rate 200 35
exec --no-startup-id setxkbmap -layout us -variant intl
exec --no-startup-id xsetroot -solid "#000000"
exec --no-startup-id dunst
exec --no-startup-id $XDG_CONFIG_HOME/fabric/start.sh
#exec --no-startup-id picom -b
exec --no-startup-id feh --bg-scale $HOME/Pictures/Wallpapers/main.png
exec --no-startup-id xautolock -time 30 -detectsleep -locker "systemctl suspend-then-hibernate"
#exec --no-startup-id xrandr --output HDMI-1 --primary --auto --output DisplayPort-0 --off
focus_follows_mouse no

bindsym $mod+z exec --no-startup-id "i3-msg exec 'sleep 0.2 && scrot -s -l mode=edge - | xclip -selection clipboard -target image/png'"

bindcode 148 exec --no-startup-id mpc toggle
bindsym $mod+Shift+space exec playerctl play-pause
bindsym $mod+Shift+e exec /usr/local/bin/emacsclient -nc
bindsym $mod+n exec $HOME/.scripts/nightlight/toggle_nightlight
bindsym $mod+Control+j exec $HOME/.scripts/open_journal

for_window [class="floating_journal"] floating enable, resize set 800 px 600 px, move position center
for_window [title="Picture-in-Picture"] floating enable, border none, sticky enable, resize set 620 px 355 px, move position 1295 px 680 px


font pango:DejaVu Sans Mono 8
floating_modifier $mod

# start rofi-emoji
bindsym $mod+Shift+p exec "rofimoji --action copy-unicode"

# start a terminal
bindsym $mod+Shift+Return exec alacritty

# kill focused window
bindsym $mod+Shift+c kill

# start dmenu (a program launcher)
bindsym $mod+p exec dmenu_run

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# split in horizontal orientation
#bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v splitt

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+v floating toggle
bindsym $mod+Shift+s sticky toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

bindsym $mod+g exec screenpen

# focus the child container
#bindsym $mod+d focus child

