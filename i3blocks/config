# i3blocks configuration file
#
# The i3blocks man page describes the usage of the binary,
# and its website describes the configuration:
#
#     https://vivien.github.io/i3blocks


# Global properties
separator=true
separator_block_width=20

[mediaplayer]
command=/home/facu/.config/i3blocks/scripts/mediaplayer
interval=1
signal=10
color=#7d7973

[volume]
command=/home/facu/.config/i3blocks/scripts/volume
LABEL=VOL 
interval=once
signal=10
MIXER=pulse
color=#7d7973

[time]
command=date '+%A, %d %B %Y %H:%M:%S'
interval=1
color=#7d7973
